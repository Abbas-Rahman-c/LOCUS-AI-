# Local-dev image for the FastAPI backend. Not a production deployment
# artifact (no multi-stage slimming, no non-root user hardening) -- it
# exists so `docker compose up` gives you a working API against the
# docker-compose `db` service without a local Poetry/Python 3.12 install.
FROM python:3.12-slim

RUN pip install --no-cache-dir poetry==1.8.3

WORKDIR /app
COPY backend/pyproject.toml backend/poetry.lock ./
RUN poetry config virtualenvs.create false \
    && poetry install --no-root --only main

COPY backend/ ./

WORKDIR /app/src
ENV PYTHONPATH=/app/src
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/src"]
