# -- Supabase -------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# -- Database ------------------------------------------------------------------
# Admin / migrations / debug scripts (postgres � bypasses row-level security)
# Pooler example (note user is postgres.<project-ref>):
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Workers + API + Edge (locus_app � subject to RLS; create via M8)
# Pooler: username MUST be locus_app.<project-ref> or you get ENOIDENTIFIER
APP_DATABASE_URL=postgresql://locus_app.your-project-ref:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct (no project-ref suffix needed):
# APP_DATABASE_URL=postgresql://locus_app:password@db.your-project-ref.supabase.co:5432/postgres

# Pool sizing: admin and app pools are sized independently. Supabase's
# pooler "Pool size" (Settings -> Database -> Connection Pooling) is a
# per user+db combination limit, so postgres (admin) and locus_app (app)
# each get their own budget from it — check your project's actual value
# for its compute tier before raising these (15 on Nano at time of writing).
# The app pool takes real request concurrency and should be sized close to
# that ceiling; the admin pool is only used for login/session lookups.
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
APP_DATABASE_POOL_MIN_SIZE=2
APP_DATABASE_POOL_MAX_SIZE=15

# -- AI Providers ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5-20251001        # Stage 1 � fast filter (dated ID required by APPROVED_TRIAGE_MODELS)
ANTHROPIC_EXTRACT_MODEL=claude-haiku-4-5-20251001       # Stage 2 � structured extraction (dated ID required by APPROVED_EXTRACTION_MODELS)

OPENAI_API_KEY=sk-...                           # Alternative provider

VOYAGE_API_KEY=pa-...
VOYAGE_EMBED_MODEL=voyage-4-large               # Document embeddings
VOYAGE_QUERY_MODEL=voyage-4-lite                # Query-side (cheaper)

# -- Slack ---------------------------------------------------------------------
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_SIGNING_SECRET=your-signing-secret        # HMAC-SHA256 webhook verification

# -- Gmail ---------------------------------------------------------------------
GMAIL_CLIENT_ID=your-client-id
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-push

# -- Notion --------------------------------------------------------------------
NOTION_CLIENT_ID=your-client-id
NOTION_CLIENT_SECRET=your-client-secret
NOTION_POLL_INTERVAL_SECONDS=300

# -- Stripe --------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -- App -----------------------------------------------------------------------
ENVIRONMENT=development                         # development | staging | production
LOG_LEVEL=INFO
APP_SECRET_KEY=generate-with-openssl-rand-hex-32
# Prefer a dedicated key for raw event encryption (falls back to APP_SECRET_KEY)
RAW_EVENTS_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# -- Retrieval -------------------------------------------------------------------
RETRIEVAL_MODE=hybrid_rrf                       # semantic_only | keyword_only | hybrid_rrf
